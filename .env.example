# Codebase Doctor Environment Configuration Example
# Copy this file to .env and configure as needed.

# Database
DATABASE_URL=sqlite:///./data/codebase_doctor.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional LLM Configuration (OpenAI-compatible)
# The application works without an LLM configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Security & Scan Limits
MAX_CLONE_SIZE_MB=50
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_MB=5
CLONE_TIMEOUT_SEC=60
ANALYZER_TIMEOUT_SEC=60
